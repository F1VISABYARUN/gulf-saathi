{
  "name": "gulf-saathi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Gulf Saathi: Telugu voice line and case system for Gulf migrant workers (TypeScript server).",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "NODE_ENV=test tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "css": "tailwindcss -i src/styles/dashboard.css -o src/styles/dashboard.built.css --minify",
    "snapshot": "UPDATE_SNAPSHOT=1 NODE_ENV=test tsx --test test/pages.test.ts"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
