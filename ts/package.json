{
  "name": "gulf-saathi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Gulf Saathi: Telugu voice line and case system for Gulf migrant workers (TypeScript server).",
  "engines": { "node": ">=20" },
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "NODE_ENV=test tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
